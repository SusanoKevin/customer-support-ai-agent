# LLM providers (free tiers)
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
GEMINI_ANSWER_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=20
GEMINI_LIVE_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
GROQ_API_KEY=
GROQ_CHAT_MODEL=

# Supabase Postgres with pgvector. Use the "Session pooler" string from
# Project > Connect (IPv4-compatible; the direct host is IPv6-only and fails on Render).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Upstash Redis (optional; in-memory limiter used if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guardrails
RAG_MIN_SIMILARITY=0.62
RAG_MIN_CHUNKS=1
AGENT_MAX_STEPS=6

# Resilience demo: probability (0.0-1.0) that a mock tool call fails
SIMULATE_TOOL_FAILURE_RATE=0.0

# Rate limiting
RATE_LIMIT_PER_MINUTE=20

# CORS
FRONTEND_ORIGIN=http://localhost:3000

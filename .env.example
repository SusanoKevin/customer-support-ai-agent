# LLM providers (free tiers)
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
GEMINI_ANSWER_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=20
# Optional: low | medium | high. Empty keeps the model default (see P10).
GEMINI_ANSWER_THINKING_LEVEL=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voice tokens are single use. The browser must connect within the window; a call lasts at most the TTL.
VOICE_TOKEN_TTL_MIN=30
VOICE_NEW_SESSION_WINDOW_S=60
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Supabase Postgres with pgvector. Use the "Session pooler" string from
# Project > Connect (IPv4-compatible; the direct host is IPv6-only and fails on Render).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Guardrails
RAG_MIN_SIMILARITY=0.62
RAG_MIN_CHUNKS=1
AGENT_MAX_STEPS=6

# Resilience demo: probability (0.0-1.0) that a mock tool call fails
SIMULATE_TOOL_FAILURE_RATE=0.0

# Rate limiting (in memory, one instance). Over the limit: HTTP 429 with Retry-After.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=60
VOICE_TOKENS_PER_HOUR=10
# Header holding the real client IP. Empty = socket address (local dev). On Render: true-client-ip.
# Only set it behind a proxy that overwrites the header; otherwise clients can forge it.
CLIENT_IP_HEADER=

# CORS: the exact frontend origin, no trailing slash (on Render: the Vercel production URL)
FRONTEND_ORIGIN=http://localhost:3000
